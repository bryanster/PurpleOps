# =============================================================================
# PurpleOps Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.

# --- MongoDB ---
MONGO_DB=assessments3
MONGO_HOST=localhost
MONGO_PORT=27017

# --- Application ---
PORT=8888
HOST=0.0.0.0
NAME=dev
DEBUG=False

# --- Security (CHANGE THESE before deploying) ---
SECRET_KEY=change-me
PASSWORD_SALT=change-me

# --- Multi-Factor Authentication ---
MFA=False
# TOTP_SECRET=             # Optional: fixed TOTP secret for testing

# --- Admin Password ---
# POPS_ADMIN_PWD=          # Set to override the auto-generated admin password on first seed

# --- OAuth2 SSO ---
OAUTH_ENABLED=false
# OAUTH_PROVIDER_NAME=SSO  # Display name shown on login button
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=           # Authorization endpoint
# OAUTH_TOKEN_URL=          # Token endpoint
# OAUTH_USERINFO_URL=       # Must return JSON with "email" field
# OAUTH_SCOPES=openid,email,profile
# OAUTH_REDIRECT_URL=       # e.g. https://purpleops.example.com/auth/oauth/callback

# --- SAML SSO ---
SAML_ENABLED=false
# SAML_IDP_METADATA_URL=   # Identity Provider metadata URL
# SAML_ENTITY_ID=           # SP entity ID (defaults to root URL)
# SAML_ROOT_URL=            # e.g. https://purpleops.example.com
# SAML_CERT_FILE=           # Path to SP certificate (PEM)
# SAML_KEY_FILE=            # Path to SP private key (PEM)

# --- SSO Shared Settings ---
# SSO_DEFAULT_ROLE=Spectator    # Default role for auto-provisioned SSO users
# SSO_AUTO_PROVISION=true       # Auto-create user accounts on first SSO login

# --- Navigator CORS ---
# NAVIGATOR_CORS_ORIGIN=https://mitre-attack.github.io  # Allowed origin for navigator JSON endpoint
